# Development placeholders only. Never commit real values.
DATABASE_URL="postgresql://archrender:replace-me@localhost:5432/archrender?schema=public"
AUTH_CONTEXT_SECRET="replace-with-at-least-32-random-bytes"
AUTH_TRUSTED_ORIGINS="http://localhost:3000"
AUTH_TRUST_PROXY="false"

# Cloudflare R2 placeholders for future server-side Asset APIs. Keep the bucket private.
R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_BUCKET_NAME="replace-with-private-bucket-name"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
# Optional override. When omitted, the endpoint is derived from R2_ACCOUNT_ID.
R2_ENDPOINT="https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com"
ASSET_STORAGE_ENVIRONMENT="development"
ASSET_MAX_UPLOAD_BYTES="26214400"
ASSET_MAX_IMAGE_DIMENSION="16384"
ASSET_MAX_DECODED_PIXELS="100000000"
ASSET_SIGNED_URL_TTL_SECONDS="300"
ASSET_INITIATE_RATE_PER_MINUTE="20"
ASSET_MAX_CONCURRENT_UPLOADS="8"
ASSET_OWNER_QUOTA_BYTES="10737418240"
ASSET_VERIFICATION_STALE_SECONDS="600"
