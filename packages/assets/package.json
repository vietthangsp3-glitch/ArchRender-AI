{
  "name": "@archrender/assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "acceptance:r2": "tsx scripts/real-r2-immutable-acceptance.ts",
    "acceptance:r2:remaining": "tsx scripts/real-r2-immutable-acceptance.ts --remaining",
    "probe:r2-finalization": "tsx scripts/real-r2-immutable-acceptance.ts --probe",
    "probe:r2-put403": "tsx scripts/r2-put403-diagnostic.ts",
    "probe": "tsx scripts/r2-put403-diagnostic.ts",
    "cleanup": "tsx scripts/cleanup-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@archrender/auth": "workspace:*",
    "@archrender/database": "workspace:*",
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@smithy/node-http-handler": "4.12.1",
    "dotenv": "^17.2.3",
    "sharp": "0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
